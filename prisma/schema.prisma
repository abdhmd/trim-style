generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Barber {
  id       Int       @id @default(autoincrement())
  name     String
  bio      String?
  bookings Booking[]
}

model Service {
  id          Int       @id @default(autoincrement())
  name        String
  description String
  price       Float
  bookings    Booking[]
}

model Booking {
  id        Int      @id @default(autoincrement())
  customer  String
  phone     String
  date      DateTime
  barber    Barber   @relation(fields: [barberId], references: [id])
  barberId  Int
  service   Service  @relation(fields: [serviceId], references: [id])
  serviceId Int
  createdAt DateTime @default(now())
}

model User {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String
}

model Contact {
  id        Int    @id @default(autoincrement())
  address   String
  phone     String
  hours     String
  facebook  String
  instagram String
  whatsapp  String
}

model Location {
  id          Int    @id @default(autoincrement())
  locationUrl String // Store the Google Maps or other location URL here
}
